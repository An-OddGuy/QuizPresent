# Copy to .env and fill in. .env is gitignored. For deploy, add the same names as GitHub Secrets.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# true = simulated Bluetooth, false = real ESP32 beacon
DEMO_BLE=true
